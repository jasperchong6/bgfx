{
  "manifest_version": 3,
  "name": "bgfx – background blur & video backgrounds",
  "version": "1.4.0",
  "description": "Blur or replace your camera background in browser video calls (Zoom web, ELO, Meet, Teams). Runs on your device; nothing is uploaded.",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["base.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["flag.js", "bgfx.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["mp/*"], "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"] }
  ]
}
